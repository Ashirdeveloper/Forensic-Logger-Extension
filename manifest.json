{
  "manifest_version": 3,
  "name": "Incognito Forensic Logger",
  "version": "1.0",
  "description": "Captures browsing visits in both normal and incognito modes for forensic analysis and allows export of logs.",
  "icons": {
    "16": "icons/icon16.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage", 
    "tabs", 
    "scripting", 
    "activeTab", 
    "downloads", 
    "webNavigation",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "incognito": "spanning",
  "action": {
    "default_popup": "popup.html"
  }
}